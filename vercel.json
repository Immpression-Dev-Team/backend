{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": "public/**"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/server.js"
        }
    ],
    "crons": [
        {
            "path": "/orders/shipments/poll-due?secret=superlongrandomstring",
            "schedule": "0 9 * * *"
        },
        {
            "path": "/orders/print-on-demand/poll-due?secret=superlongrandomstring",
            "schedule": "0 9 * * *"
        }
    ]
}